#!/usr/bin/make -f
TOOLCHAIN := $(shell python3 -c 'import tomllib; print(tomllib.load(open("rust-toolchain.toml", "rb"))["toolchain"]["channel"])')
CARGO_TARGET = x86_64-unknown-linux-gnu
export RUSTUP_TOOLCHAIN = $(TOOLCHAIN)
export RUSTFLAGS = -C target-cpu=x86-64 --remap-path-prefix=$(CURDIR)=.
export CFLAGS = $(shell dpkg-buildflags --get CFLAGS) -march=x86-64 -mtune=generic
export CXXFLAGS = $(shell dpkg-buildflags --get CXXFLAGS) -march=x86-64 -mtune=generic
export CARGO_NET_OFFLINE = true
export CARGO_TARGET_DIR = $(CURDIR)/debian/cargo-target
DOC = $(CURDIR)/debian/capsa-core/usr/share/doc/capsa-core

ifneq ($(shell printf '%s\n' '$(TOOLCHAIN)' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$$' >/dev/null && echo yes),yes)
$(error rust-toolchain.toml must pin an exact x.y.z Rust release)
endif
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
ifeq ($(DEB_HOST_ARCH),amd64)
else
$(error capsa-core is supported only on amd64)
endif

%:
	dh $@ --buildsystem=none

# Cargo verifies every vendored file. Debhelper's generic autotools refresh and
# backup-file cleanup must not rewrite config.{sub,guess} or delete *.orig.
override_dh_update_autotools_config:
	:

override_dh_autoreconf:
	:

override_dh_autoreconf_clean:
	:

override_dh_clean:
	dh_clean --exclude=vendor/

override_dh_auto_build:
	rustup run "$(TOOLCHAIN)" cargo build --release --locked --offline --bin capsa --target "$(CARGO_TARGET)"

override_dh_auto_test:
	$(CARGO_TARGET_DIR)/$(CARGO_TARGET)/release/capsa --help >/dev/null

override_dh_auto_install:
	install -D -m 0755 $(CARGO_TARGET_DIR)/$(CARGO_TARGET)/release/capsa $(CURDIR)/debian/capsa-core/usr/bin/capsa
	install -d $(DOC)/vendor
	install -m 0644 README.md LICENSE Cargo.lock $(DOC)/
	cd vendor && find . -type f \( -name Cargo.toml -o -iname 'LICENSE*' -o -iname 'LICENCE*' -o -iname 'COPYING*' -o -iname 'NOTICE*' -o -iname 'UNLICENSE*' \) -exec cp --parents -t $(DOC)/vendor {} +
	python3 debian/install-extra.py

override_dh_installsystemd:
	dh_installsystemd --no-start --no-enable --no-stop-on-upgrade

override_dh_auto_clean:
	rm -rf debian/cargo-target
