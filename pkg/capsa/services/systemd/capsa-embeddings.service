[Unit]
Description=Capsa Nomic embedding server
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=capsa
Group=capsa
UMask=0077
Environment=HOME=/var/lib/capsa
Environment=HF_HOME=/usr/share/capsa/tokenizers
Environment=HF_HUB_OFFLINE=1
Environment=CAPSA_EMBEDDING_PROFILE=nomic-embed-text-v1.5.Q4_K_M
Environment=CAPSA_THREADS=24
EnvironmentFile=-/etc/capsa/embeddings.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/lib/capsa/python/bin/python3.12 -I -B /usr/lib/capsa/services/capsa-service-helper preflight-assets
ExecStart=/usr/bin/capsa-llama-server --host 127.0.0.1 --port 9001 --model /usr/share/capsa/models/nomic-embed-text-v1.5.Q4_K_M.gguf --embeddings --threads ${CAPSA_THREADS} --batch-size 4096 --ubatch-size 4096
ExecStartPost=/usr/lib/capsa/python/bin/python3.12 -I -B /usr/lib/capsa/services/capsa-service-helper wait-embeddings
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/etc/capsa /usr/share/capsa /usr/lib/capsa /usr/bin/capsa-llama-server
ReadWritePaths=/var/lib/capsa /var/cache/capsa

[Install]
WantedBy=multi-user.target
